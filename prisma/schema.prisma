// 数据库模型（规范第 4 节原文落地）。
// 开发用 SQLite（零配置、单文件 prisma/dev.db），生产切 PostgreSQL：
// 只改 datasource.provider 与 DATABASE_URL，模型与代码无需变动（ADR-002）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // 开发环境；生产环境切换为 postgresql
  url      = env("DATABASE_URL")
}

// 用户表：一期只有 seed/ensureDefaultUser 创建的本地默认用户；
// 二期接 NextAuth 时在此扩展账号/会话模型，Site.userId 外键保持不变。
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  sites     Site[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 站点表：content 存 SiteData 的 JSON 字符串（SQLite 无原生 JSON 列，
// 字符串方案跨数据库通用）；template/status 用字符串而非枚举，
// 便于二期新增模板/状态时不需要迁移数据库，合法性由 Zod 在边界保证。
model Site {
  id           String   @id @default(uuid())
  name         String
  template     String // minimal | tech | creative | professional | ink | brutal | aurora | editorial
  content      String // JSON 字符串，存储网站内容
  status       String   @default("draft") // draft | published
  customDomain String?  @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 模板注册表：seed 写入八套模板元数据（config 为 lib/templates.ts 的 JSON 快照），
// 供 /api/templates 与二期模板管理端消费；isDefault 标记新建站点的默认模板。
model Template {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String
  thumbnail   String?
  config      String // JSON 配置
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}